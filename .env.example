# Copy to .env (git-ignored), fill in, and use with: uv run --env-file .env evidence-timeline ...

# OpenAI-compatible API. Default: OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Your API key. Never commit a real key.
LLM_API_KEY=

# Exact model ID, e.g. an OpenRouter model that supports structured outputs. There is no default.
LLM_MODEL=
