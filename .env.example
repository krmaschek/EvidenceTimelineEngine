# Copy this file to .env and add your API key. Git ignores .env, so the key stays on your machine.

# OpenAI-compatible API. Default: OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Your API key. Never commit a real key.
LLM_API_KEY=

# Exact model ID of a model that supports structured outputs. The evaluation picked this one.
LLM_MODEL=google/gemini-3.8-flash

# Optional: the only OpenRouter provider to use; this is the host the evaluation used.
# Empty: OpenRouter picks a host per request.
LLM_PROVIDER=google-ai-studio

# The PostgreSQL database from docker-compose.yml. Leave empty to run without saving to a database.
DATABASE_URL=postgresql+asyncpg://evidence:evidence@localhost:5433/evidence_timeline
